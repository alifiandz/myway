{
  "name": "myway",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && bash scripts/sites-env.sh -- node --experimental-strip-types --test tests/*.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test:examples": "npm --prefix examples/engineering test",
    "dev:isolated": "node scripts/isolated-dev.mjs",
    "test:isolated": "bash scripts/sites-env.sh -- node --experimental-strip-types --import ./tests/deny-network.mjs --test tests/authorization-boundaries.test.mjs tests/cloud-document-vault.test.mjs tests/cloud-document-storage-client.test.mjs tests/account-sync.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.68.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "26.6.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.39",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.2.1",
    "vite": "8.3.8",
    "wrangler": "4.157.0"
  },
  "type": "module",
  "displayName": "MyWay",
  "overrides": {
    "image-size": "2.1.0"
  }
}
